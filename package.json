{
  "name": "tpq-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build:client": "npm run build --workspace=client",
    "build:server": "npx prisma generate --schema=server/prisma/schema.prisma",
    "build": "npm run build:client && npm run build:server"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^4.0.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
